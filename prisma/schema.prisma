generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

// LUMPSUM = Composition scheme (lumpsum) dealer: issues a Bill of Supply
// and cannot collect GST, so no tax is added to the invoice.
enum InvoiceTaxType {
  CGST_SGST
  IGST
  LUMPSUM
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id Int @id @default(autoincrement())

  username     String  @unique
  passwordHash String
  fullName     String
  email        String  @unique
  role         UserRole @default(USER)
  isActive     Boolean @default(true)

  // Seller/business profile snapshot used to prefill Create New Invoice for
  // this user. Nullable: an account may not have seller details configured
  // yet (e.g. brand-new normal users), in which case the invoice create
  // screen must show a "not configured" message rather than defaulting to
  // another user's details.
  sellerName      String?
  sellerPhone     String?
  sellerAddress   String?
  sellerGSTIN     String?
  sellerPAN       String?
  sellerState     String?
  sellerStateCode String?

  // Bank details printed on this user's invoices. Copied onto each invoice
  // when it is saved (see Invoice bank snapshot).
  bankName          String?
  bankBranchName    String?
  bankAccountNumber String?
  bankIfscCode      String?

  // Optional signature image (data: URL, resized client-side) shown above
  // "Authorised Signatory" on this user's invoices. Read live from the
  // owner, so it is not snapshotted onto invoices.
  signatureImage String?

  // Invoice number template, e.g. "KE/{FY}/{N3}" (see src/lib/invoiceNumber.ts).
  // Null = default "{FY}/{N}" -> "26-27/01".
  invoiceNumberFormat String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  invoices            Invoice[]
  passwordResetTokens PasswordResetToken[]
  invoiceSequences    InvoiceSequence[]

  @@index([role])
}

// One-time password reset links (sent to the admin's WhatsApp). Only a
// SHA-256 hash of the token is stored, so a DB leak can't be used to reset
// passwords; each token expires quickly and can be used once.
model PasswordResetToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Invoice {
  id Int @id @default(autoincrement())

  // Unique per owner: each user is a separate business with its own series.
  invoiceNumber String
  // Counter value used for an auto-numbered invoice (null when the number
  // was entered manually). Lets deleting the latest invoice roll the
  // owner's counter back so the next invoice reuses the number.
  sequenceNumber Int?
  invoiceDate   DateTime
  financialYear String

  // Owning user. Normal users only see/manage their own invoices; Admins
  // see all invoices. Existing pre-auth invoices are backfilled to the
  // initial Admin account by the accompanying migration.
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  status  InvoiceStatus  @default(DRAFT)
  taxType InvoiceTaxType

  // Seller snapshot
  sellerName      String
  sellerGSTIN     String?
  sellerPAN       String?
  sellerAddress   String?
  sellerState     String?
  sellerStateCode String?
  sellerEmail     String?
  sellerPhone     String?

  // Bank snapshot, copied from the owner's bank details on every save
  bankName          String?
  bankBranchName    String?
  bankAccountNumber String?
  bankIfscCode      String?

  // Buyer snapshot
  buyerName      String
  buyerGSTIN     String?
  buyerPAN       String?
  buyerAddress   String?
  buyerState     String?
  buyerStateCode String?
  buyerEmail     String?
  buyerPhone     String?
  buyerAadhaar   String?

  // Additional invoice metadata (Umiya template fields)
  deliveryNote      String?
  buyerOrderNo      String?
  buyerOrderDate    DateTime?
  dispatchDocNo     String?
  deliveryNoteDate  DateTime?
  dispatchedThrough String?
  destination       String?

  // Amounts
  subtotal   Decimal @db.Decimal(15, 2)
  totalCGST  Decimal @default(0) @db.Decimal(15, 2)
  totalSGST  Decimal @default(0) @db.Decimal(15, 2)
  totalIGST  Decimal @default(0) @db.Decimal(15, 2)
  roundOff   Decimal @default(0) @db.Decimal(15, 2)
  grandTotal Decimal @db.Decimal(15, 2)

  // Optional invoice information
  notes              String?
  termsAndConditions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]

  @@index([invoiceDate])
  @@index([financialYear])
  @@index([status])
  @@index([buyerGSTIN])
  @@unique([ownerId, invoiceNumber])
  @@index([ownerId])
}

// Auto-numbering counter, one per user per financial year.
model InvoiceSequence {
  id Int @id @default(autoincrement())

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  financialYear String
  lastNumber    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, financialYear])
}

model InvoiceItem {
  id Int @id @default(autoincrement())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  hsn         String?
  quantity    Decimal @db.Decimal(15, 3)
  unit        String?
  rate        Decimal @db.Decimal(15, 2)

  gstRate Decimal @db.Decimal(5, 2)

  taxableAmount Decimal @db.Decimal(15, 2)

  cgstAmount Decimal @default(0) @db.Decimal(15, 2)
  sgstAmount Decimal @default(0) @db.Decimal(15, 2)
  igstAmount Decimal @default(0) @db.Decimal(15, 2)

  totalAmount Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}
